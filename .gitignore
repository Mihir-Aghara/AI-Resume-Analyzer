## ==============================================================================
## Standard .NET & Visual Studio Git Ignore Rules
## AI Resume Analyzer - ASP.NET Core MVC & ADO.NET Architecture
## ==============================================================================

# User-specific files & Visual Studio temporary files
*.user
*.userosscache
*.sln.docstates
*.suo
.vs/
.vscode/
.idea/

# Build results & Binaries
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
publish/
*.nupkg

# Dynamic Resume Uploads & Temporary Parsing Artifacts
# Ensures directory structure exists via .gitkeep while ignoring all uploaded user resumes
src/AIResumeAnalyzer/App_Data/Resumes/*
!src/AIResumeAnalyzer/App_Data/Resumes/.gitkeep

# Environment-specific configuration and secrets
appsettings.Development.json
appsettings.*.local.json
*.local.json
*.secrets.json

# Automated Test Results and Code Coverage
TestResults/
[Tt]est[Rr]esult*/
*.coverage
*.coveragexml

# SQL Server database files & LocalDB runtime logs
*.mdf
*.ldf
*.ndf
*.bak

# Submission archives & Staging folders
*.zip
AI_Resume_Analyzer_Submission/

# Operating System files
.DS_Store
Thumbs.db
desktop.ini
