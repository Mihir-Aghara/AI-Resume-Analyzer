@model ErrorViewModel
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Something Went Wrong";
    bool isLoggedIn = (HttpContextAccessor.HttpContext?.Session.GetInt32(SessionKeys.UserId) ?? 0) > 0;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 text-center">
                <div class="mx-auto mb-3 d-inline-flex align-items-center justify-content-center rounded-circle bg-danger bg-opacity-10 text-danger" style="width: 72px; height: 72px;">
                    <i class="bi bi-exclamation-triangle-fill fs-2"></i>
                </div>

                <h2 class="fw-bold mb-2">@(Model.ErrorTitle ?? "Something Went Wrong")</h2>
                <p class="text-muted mb-4">
                    @(Model.ErrorMessage ?? "We ran into an unexpected hiccup while processing your request. Your data is safe — please try again.")
                </p>

                @if (!string.IsNullOrWhiteSpace(Model.DeveloperDetail))
                {
                    <div class="alert alert-warning text-start small rounded-3 mb-4">
                        <div class="fw-bold mb-1"><i class="bi bi-bug me-1"></i>Diagnostic Details</div>
                        @if (!string.IsNullOrWhiteSpace(Model.FailedPath))
                        {
                            <div class="text-muted mb-1">Route: <code>@Model.FailedPath</code></div>
                        }
                        <div class="font-monospace text-break">@Model.DeveloperDetail</div>
                    </div>
                }

                <div class="d-flex flex-wrap justify-content-center gap-2 mb-3">
                    @if (isLoggedIn)
                    {
                        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary rounded-pill px-4">
                            <i class="bi bi-speedometer2 me-1"></i>Back to Dashboard
                        </a>
                    }
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-house me-1"></i>Go to Home
                    </a>
                </div>

                @if (Model.ShowRequestId)
                {
                    <div class="text-muted small mt-2">
                        Reference ID: <code>@Model.RequestId</code>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
