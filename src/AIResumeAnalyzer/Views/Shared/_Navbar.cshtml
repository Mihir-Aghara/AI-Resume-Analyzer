@inject IHttpContextAccessor HttpContextAccessor
@{
    var userClaims = User;
    bool isAuth = userClaims.Identity?.IsAuthenticated == true;
    var session = HttpContextAccessor.HttpContext?.Session;
    int? userId = session?.GetInt32(SessionKeys.UserId);
    string? userName = session?.GetString(SessionKeys.UserName) ?? userClaims.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value;
    string? userEmail = session?.GetString(SessionKeys.UserEmail) ?? userClaims.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;
    string? userRole = session?.GetString(SessionKeys.UserRole) ?? userClaims.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    bool isLoggedIn = (userId.HasValue && userId.Value > 0) || isAuth;
    bool isAdmin = string.Equals(userRole, "Admin", StringComparison.OrdinalIgnoreCase);
}

<nav class="navbar navbar-expand-lg navbar-light sticky-top py-3 navbar-glass">
    <div class="container">
        <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-dark fs-4" asp-controller="Home" asp-action="Index">
            <span class="p-2 rounded-3 bg-primary text-white d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 36px; height: 36px;">
                <i class="bi bi-file-earmark-text-fill"></i>
            </span>
            <span>AI Resume<span class="text-primary">Analyzer</span></span>
        </a>

        <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarMain">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                @if (isLoggedIn)
                {
                    <li class="nav-item">
                        <a class="nav-link text-secondary fw-medium hover-text-primary" asp-controller="Dashboard" asp-action="Index">
                            <i class="bi bi-speedometer2 me-1"></i>Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-secondary fw-medium hover-text-primary" asp-controller="Resume" asp-action="Upload">
                            <i class="bi bi-cloud-arrow-up me-1"></i>Upload Resume
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-secondary fw-medium hover-text-primary" asp-controller="Analysis" asp-action="Create">
                            <i class="bi bi-cpu me-1"></i>Analyze
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-secondary fw-medium hover-text-primary" asp-controller="Analysis" asp-action="History">
                            <i class="bi bi-clock-history me-1"></i>History
                        </a>
                    </li>

                    @if (isAdmin)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-warning fw-semibold" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-shield-lock me-1"></i>Admin Center
                            </a>
                            <ul class="dropdown-menu shadow-lg border-0 rounded-3">
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Admin" asp-action="Dashboard">
                                        <i class="bi bi-graph-up-arrow me-2 text-primary"></i>System Analytics
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Admin" asp-action="Users">
                                        <i class="bi bi-people me-2 text-info"></i>Manage Users
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link text-secondary fw-medium hover-text-primary" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-secondary fw-medium hover-text-primary" asp-controller="Home" asp-action="Index" asp-fragment="features">Features</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-secondary fw-medium hover-text-primary" asp-controller="Home" asp-action="Index" asp-fragment="how-it-works">How It Works</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-secondary fw-medium hover-text-primary" asp-controller="Home" asp-action="Index" asp-fragment="methodology">Scoring System</a>
                    </li>
                }
            </ul>

            <div class="d-flex align-items-center gap-2">
                @if (isLoggedIn)
                {
                    <div class="dropdown">
                        <button class="btn btn-outline-secondary dropdown-toggle rounded-pill px-3 py-1 d-flex align-items-center gap-2 text-dark" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle text-primary"></i>
                            <span class="d-none d-sm-inline fw-semibold">@(userName ?? "My Account")</span>
                            @if (isAdmin)
                            {
                                <span class="badge bg-danger rounded-pill ms-1">Admin</span>
                            }
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-3">
                            <li>
                                <div class="px-3 py-2 border-bottom">
                                    <div class="fw-semibold text-dark">@(userName ?? "User")</div>
                                    <div class="small text-muted text-truncate" style="max-width: 200px;">@(userEmail ?? "")</div>
                                </div>
                            </li>
                            <li>
                                <a class="dropdown-item py-2 mt-1" asp-controller="Account" asp-action="Profile">
                                    <i class="bi bi-person me-2 text-primary"></i>My Profile
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-2" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-2 text-info"></i>Dashboard
                                </a>
                            </li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item py-2 text-danger">
                                        <i class="bi bi-box-arrow-right me-2"></i>Sign Out
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary rounded-pill px-3 py-1 fw-medium">
                        <i class="bi bi-box-arrow-in-right me-1"></i>Sign In
                    </a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-primary rounded-pill px-4 py-1 fw-semibold shadow-sm">
                        Get Started Free
                    </a>
                }
            </div>
        </div>
    </div>
</nav>
