@model AIResumeAnalyzer.Models.ResumeAnalysis
@{
    Layout = null;
    string rating = Model.OverallScore >= 75 ? "HIGH COMPATIBILITY" : Model.OverallScore >= 50 ? "MODERATE COMPATIBILITY" : "LOW COMPATIBILITY (ACTION REQUIRED)";
    string badgeColor = Model.OverallScore >= 75 ? "#10b981" : Model.OverallScore >= 50 ? "#f59e0b" : "#ef4444";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ATS Benchmark Report - @Model.JobTitle - @Model.ResumeFileName</title>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        * { box-sizing: border-box; }
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            color: #1e293b;
            background-color: #ffffff;
            margin: 0;
            padding: 30px;
            font-size: 13px;
            line-height: 1.5;
        }

        .report-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid #2563eb;
            padding-bottom: 15px;
            margin-bottom: 25px;
        }

        .brand-title {
            font-size: 22px;
            font-weight: 800;
            color: #0f172a;
        }

        .brand-title span { color: #2563eb; }
        .report-tag {
            background-color: #eff6ff;
            color: #2563eb;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .meta-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
            background-color: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 25px;
        }

        .meta-item strong { color: #64748b; font-size: 11px; text-transform: uppercase; display: block; }
        .meta-item span { font-weight: 600; font-size: 14px; color: #0f172a; }

        .score-hero {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            color: #ffffff;
            border-radius: 10px;
            padding: 20px 30px;
            margin-bottom: 25px;
        }

        .score-box {
            font-size: 48px;
            font-weight: 800;
            color: @badgeColor;
            line-height: 1;
        }

        .section-title {
            font-size: 15px;
            font-weight: 700;
            color: #0f172a;
            border-bottom: 1px solid #e2e8f0;
            padding-bottom: 6px;
            margin-top: 25px;
            margin-bottom: 12px;
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }

        th, td {
            padding: 8px 12px;
            text-align: left;
            border-bottom: 1px solid #e2e8f0;
        }

        th {
            background-color: #f8fafc;
            font-size: 11px;
            text-transform: uppercase;
            color: #64748b;
        }

        .badge-matched {
            background-color: #dcfce7;
            color: #166534;
            padding: 3px 8px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 600;
        }

        .badge-missing {
            background-color: #fee2e2;
            color: #991b1b;
            padding: 3px 8px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 600;
        }

        .priority-high { background-color: #fee2e2; color: #991b1b; padding: 2px 8px; border-radius: 10px; font-weight: 700; font-size: 10px; }
        .priority-med { background-color: #fef3c7; color: #92400e; padding: 2px 8px; border-radius: 10px; font-weight: 700; font-size: 10px; }
        .priority-low { background-color: #e0f2fe; color: #075985; padding: 2px 8px; border-radius: 10px; font-weight: 700; font-size: 10px; }

        .disclaimer-box {
            background-color: #f1f5f9;
            border-left: 3px solid #64748b;
            padding: 10px 15px;
            font-size: 11px;
            color: #475569;
            margin-top: 30px;
        }

        .no-print-bar {
            background-color: #f8fafc;
            border-bottom: 1px solid #e2e8f0;
            padding: 12px 30px;
            margin: -30px -30px 25px -30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .btn-print {
            background-color: #2563eb;
            color: #ffffff;
            border: none;
            padding: 8px 20px;
            border-radius: 20px;
            font-weight: 600;
            cursor: pointer;
            font-size: 13px;
        }

        @@media print {
            body { padding: 0; }
            .no-print-bar { display: none !important; }
        }
    </style>
</head>
<body>
    <div class="no-print-bar">
        <div>
            <strong>AI Resume Analyzer</strong> · Official Academic Evaluation Report
        </div>
        <div>
            <button class="btn-print" onclick="window.print()"><i class="bi bi-printer"></i> Print / Save as PDF</button>
        </div>
    </div>

    <div class="report-header">
        <div>
            <div class="brand-title">AI Resume<span>Analyzer</span></div>
            <div style="font-size: 12px; color: #64748b;">Explainable ATS Resume Benchmarking Engine · Academic Capstone Submission</div>
        </div>
        <div>
            <span class="report-tag">Evaluation Report #@Model.AnalysisId</span>
        </div>
    </div>

    <!-- Metadata Block -->
    <div class="meta-grid">
        <div class="meta-item">
            <strong>Target Position:</strong>
            <span>@Model.JobTitle</span>
        </div>
        <div class="meta-item">
            <strong>Target Company:</strong>
            <span>@(Model.CompanyName ?? "General Technical Specification")</span>
        </div>
        <div class="meta-item">
            <strong>Evaluated Resume Document:</strong>
            <span>@Model.ResumeFileName</span>
        </div>
        <div class="meta-item">
            <strong>Analysis Generation Date:</strong>
            <span>@Model.CreatedAt.ToString("MMMM dd, yyyy · hh:mm tt") UTC</span>
        </div>
    </div>

    <!-- Overall Score Hero Banner -->
    <div class="score-hero">
        <div>
            <div style="text-transform: uppercase; font-size: 12px; letter-spacing: 0.05em; color: #94a3b8;">ATS Compatibility Score</div>
            <div style="font-size: 22px; font-weight: 700; margin-top: 4px;">@rating</div>
            <div style="font-size: 12px; color: #cbd5e1; margin-top: 2px;">
                Matched @Model.MatchedSkillsCount of @Model.TotalSkillsIdentified identified technical requirements
            </div>
        </div>
        <div style="text-align: right;">
            <div class="score-box">@Model.OverallScore.ToString("F1")%</div>
            <div style="font-size: 11px; color: #94a3b8; text-transform: uppercase;">Composite Weighted Score</div>
        </div>
    </div>

    <!-- 4-Pillar Score Breakdown Table -->
    <div class="section-title">1. Evaluation Metric Breakdown</div>
    <table>
        <thead>
            <tr>
                <th>Evaluation Pillar</th>
                <th>Standard Weight</th>
                <th>Achieved Score</th>
                <th>Weighted Contribution</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><strong>Technical Skills Match</strong> (Taxonomy Keyword Alignment)</td>
                <td>40%</td>
                <td>@Model.SkillsScore.ToString("F1")%</td>
                <td><strong>@((Model.SkillsScore * 0.40m).ToString("F1"))%</strong></td>
            </tr>
            <tr>
                <td><strong>Lexical Keyword Overlap</strong> (N-gram Jaccard Overlap)</td>
                <td>25%</td>
                <td>@Model.KeywordsScore.ToString("F1")%</td>
                <td><strong>@((Model.KeywordsScore * 0.25m).ToString("F1"))%</strong></td>
            </tr>
            <tr>
                <td><strong>Relevant Experience Alignment</strong> (Action Verbs &amp; Scope)</td>
                <td>20%</td>
                <td>@Model.ExperienceScore.ToString("F1")%</td>
                <td><strong>@((Model.ExperienceScore * 0.20m).ToString("F1"))%</strong></td>
            </tr>
            <tr>
                <td><strong>Education &amp; Qualifications</strong> (Degree &amp; Coursework Alignment)</td>
                <td>15%</td>
                <td>@Model.EducationScore.ToString("F1")%</td>
                <td><strong>@((Model.EducationScore * 0.15m).ToString("F1"))%</strong></td>
            </tr>
            <tr style="background-color: #f8fafc; font-weight: 700;">
                <td>Total Composite Compatibility Score</td>
                <td>100%</td>
                <td>-</td>
                <td style="color: @badgeColor; font-size: 14px;">@Model.OverallScore.ToString("F1")%</td>
            </tr>
        </tbody>
    </table>

    <!-- Technical Skills Breakdown Table -->
    <div class="section-title">2. Technical Skills &amp; Competencies Analysis</div>
    <table>
        <thead>
            <tr>
                <th>Technical Skill</th>
                <th>Domain Category</th>
                <th>Presence Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var skill in Model.Skills)
            {
                <tr>
                    <td><strong>@skill.SkillName</strong></td>
                    <td>@skill.Category</td>
                    <td>
                        @if (skill.IsMatched)
                        {
                            <span class="badge-matched"><i class="bi bi-check2"></i> Matched in Resume</span>
                        }
                        else
                        {
                            <span class="badge-missing"><i class="bi bi-x"></i> Missing Requirement</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Actionable Recommendations Table -->
    <div class="section-title">3. Actionable Resume Improvement Recommendations</div>
    <table>
        <thead>
            <tr>
                <th style="width: 15%;">Priority</th>
                <th style="width: 25%;">Category</th>
                <th style="width: 60%;">Specific Actionable Guidance</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var rec in Model.Recommendations)
            {
                <tr>
                    <td>
                        <span class="@(rec.Priority == "High" ? "priority-high" : rec.Priority == "Medium" ? "priority-med" : "priority-low")">
                            @rec.Priority
                        </span>
                    </td>
                    <td><strong>@rec.Category</strong></td>
                    <td>@rec.Suggestion.Replace("**", "")</td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Methodology Disclaimer -->
    <div class="disclaimer-box">
        <strong>Academic Evaluation Methodology:</strong>
        This report was generated using the explainable 4-pillar keyword and taxonomy algorithm developed as part of a B.Tech Computer Engineering capstone project in ASP.NET Core MVC &amp; ADO.NET. Scores represent algorithmic heuristic benchmarks designed to assist students in discovering technical curriculum gaps, and do not represent proprietary third-party ATS vendor algorithms.
    </div>
</body>
</html>
