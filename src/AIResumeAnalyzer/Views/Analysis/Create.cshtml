@model AIResumeAnalyzer.ViewModels.AnalysisRequestViewModel
@{
    ViewData["Title"] = "New Resume Analysis - AI Resume Analyzer";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <div>
                    <h2 class="fw-bold mb-1"><i class="bi bi-cpu text-primary me-2"></i>Analyze Resume Match</h2>
                    <p class="text-muted mb-0">Select your uploaded resume and provide the target job requirements to compute an explainable ATS score.</p>
                </div>
                <a asp-action="History" class="btn btn-outline-secondary rounded-pill">
                    <i class="bi bi-clock-history me-1"></i>Analysis History
                </a>
            </div>

            <partial name="_NotificationPartial" />

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Create" method="post" id="analysisForm">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4"></div>

                        <!-- 1. Select Resume Document -->
                        <div class="mb-4">
                            <label asp-for="ResumeId" class="form-label fw-bold small text-muted text-uppercase">1. Choose Candidate Document</label>
                            <select asp-for="ResumeId" class="form-select form-select-lg rounded-3" required>
                                @foreach (var r in Model.AvailableResumes)
                                {
                                    <option value="@r.ResumeId">
                                        @r.OriginalFileName (@r.FileType.ToUpperInvariant() · @r.UploadedAt.ToString("MMM dd, yyyy"))
                                    </option>
                                }
                            </select>
                            <span asp-validation-for="ResumeId" class="text-danger small"></span>
                            <div class="form-text">
                                Don't see the right resume? <a asp-controller="Resume" asp-action="Upload" class="text-decoration-none">Upload another document here</a>.
                            </div>
                        </div>

                        <!-- 2. Target Job Metadata -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-7">
                                <label asp-for="JobTitle" class="form-label fw-bold small text-muted text-uppercase">2. Target Position / Role</label>
                                <input asp-for="JobTitle" class="form-control rounded-3" id="jobTitleInput" placeholder="e.g. .NET Core Backend Engineer" required />
                                <span asp-validation-for="JobTitle" class="text-danger small"></span>
                            </div>
                            <div class="col-md-5">
                                <label asp-for="CompanyName" class="form-label fw-bold small text-muted text-uppercase">Company Name (Optional)</label>
                                <input asp-for="CompanyName" class="form-control rounded-3" id="companyNameInput" placeholder="e.g. TechCorp Solutions" />
                                <span asp-validation-for="CompanyName" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Quick Sample Load for Academic Demo -->
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <label asp-for="JobDescriptionText" class="form-label fw-bold small text-muted text-uppercase mb-0">
                                3. Paste Target Job Description
                            </label>
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-primary dropdown-toggle rounded-pill" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-magic me-1"></i>Load Demo Job Descriptions
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="loadSampleDotNet()">.NET Backend Engineer Job</a></li>
                                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="loadSampleFullStack()">Full Stack C# / Web Engineer</a></li>
                                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="loadSampleJuniorDev()">Junior Software Graduate Role</a></li>
                                </ul>
                            </div>
                        </div>

                        <!-- 3. Job Description Text Area -->
                        <div class="mb-4">
                            <textarea asp-for="JobDescriptionText" class="form-control rounded-3" id="jobDescArea" rows="10" placeholder="Paste the full job specification, required technical skills, responsibilities, and minimum education requirements here..." required></textarea>
                            <div class="d-flex justify-content-between mt-1">
                                <span asp-validation-for="JobDescriptionText" class="text-danger small"></span>
                                <small class="text-muted" id="charCount">0 characters</small>
                            </div>
                        </div>

                        <!-- 4. Submit Button -->
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-semibold shadow-sm" id="submitBtn">
                                <span class="spinner-border spinner-border-sm me-2 d-none" id="submitSpinner" role="status"></span>
                                <i class="bi bi-lightning-charge me-1" id="submitIcon"></i>Execute Compatibility Analysis
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const jobDescArea = document.getElementById('jobDescArea');
        const charCount = document.getElementById('charCount');
        const jobTitleInput = document.getElementById('jobTitleInput');
        const companyNameInput = document.getElementById('companyNameInput');
        const analysisForm = document.getElementById('analysisForm');
        const submitBtn = document.getElementById('submitBtn');
        const submitSpinner = document.getElementById('submitSpinner');
        const submitIcon = document.getElementById('submitIcon');

        function updateCharCount() {
            charCount.textContent = jobDescArea.value.length + ' characters';
        }

        jobDescArea.addEventListener('input', updateCharCount);
        updateCharCount();

        function loadSampleDotNet() {
            jobTitleInput.value = ".NET Core Backend Developer";
            companyNameInput.value = "TechNova Solutions";
            jobDescArea.value = `We are seeking a talented .NET Core Backend Developer to engineer robust enterprise APIs.
Required Qualifications:
- 1-3 years of proven experience in C# and ASP.NET Core MVC/Web API.
- Deep proficiency in Microsoft SQL Server, relational schema design, and ADO.NET data access.
- Solid understanding of Object-Oriented Programming (OOP), Data Structures, Algorithms, and Clean Architecture.
- Hands-on version control with Git and GitHub.
- Familiarity with containerization using Docker and Machine Learning basics is an advantage.
- Bachelor's degree (B.Tech / B.E.) in Computer Engineering, Computer Science or equivalent.`;
            updateCharCount();
        }

        function loadSampleFullStack() {
            jobTitleInput.value = "Full Stack C# Web Engineer";
            companyNameInput.value = "Global Dynamics";
            jobDescArea.value = `Join our engineering team to build scalable web portals using Microsoft .NET technologies.
Key Requirements:
- Hands-on expertise with C#, ASP.NET MVC, and Razor views.
- Client-side skills: HTML5, CSS3, JavaScript, and Bootstrap styling.
- Strong relational database experience with SQL, SQL Server, and stored procedures.
- Understanding of Dependency Injection and RESTful API integration.
- Degree: B.Tech / B.Sc in Computer Science or Information Technology.`;
            updateCharCount();
        }

        function loadSampleJuniorDev() {
            jobTitleInput.value = "Graduate Software Engineer";
            companyNameInput.value = "Apex Cloud Systems";
            jobDescArea.value = `Exciting entry-level opportunity for recent B.Tech engineering graduates.
Required Skills:
- Academic foundation in C# or Python programming languages.
- Fundamental knowledge of Data Structures, Algorithms, and OOP concepts.
- Understanding of Database management systems and SQL queries.
- Collaborative mindset, Git usage, and eagerness to learn ASP.NET Core cloud development.`;
            updateCharCount();
        }

        analysisForm.addEventListener('submit', function () {
            if (analysisForm.checkValidity()) {
                submitBtn.disabled = true;
                submitSpinner.classList.remove('d-none');
                submitIcon.classList.add('d-none');
                submitBtn.innerText = ' Analyzing Resume Compatibility...';
                submitBtn.prepend(submitSpinner);
            }
        });
    </script>
}
