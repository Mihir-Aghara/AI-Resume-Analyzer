@{
    ViewData["Title"] = "Access Denied - AI Resume Analyzer";
}

<div class="row justify-content-center py-5 text-center">
    <div class="col-md-7 col-lg-5">
        <div class="card border-0 shadow-lg rounded-4 p-5">
            <div class="mb-3 text-danger">
                <i class="bi bi-shield-x" style="font-size: 5rem;"></i>
            </div>
            <h2 class="fw-bold text-dark mb-2">403 - Access Denied</h2>
            <p class="text-muted mb-4">
                You do not have administrative privileges to access this page or resource. Administrative pages are strictly restricted to verified system administrators.
            </p>
            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary rounded-pill px-4">
                    <i class="bi bi-speedometer2 me-1"></i>Go to User Dashboard
                </a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="bi bi-box-arrow-in-right me-1"></i>Switch Account
                </a>
            </div>
        </div>
    </div>
</div>
