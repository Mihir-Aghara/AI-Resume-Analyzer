@model AIResumeAnalyzer.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password - AI Resume Analyzer";
}

<div class="row justify-content-center py-5">
    <div class="col-12 col-md-8 col-lg-5 col-xl-4">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="card-header bg-dark text-white text-center py-4 border-0">
                <div class="d-inline-flex p-3 rounded-circle bg-primary bg-opacity-25 mb-3">
                    <span class="p-2 rounded-3 bg-primary text-white d-inline-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                        <i class="bi bi-key-fill fs-4"></i>
                    </span>
                </div>
                <h3 class="fw-bold mb-1">Reset Password</h3>
                <p class="text-white-50 mb-0 small">Enter your email to receive a password reset link</p>
            </div>

            <div class="card-body p-4 p-md-4">
                <partial name="_NotificationPartial" />

                <form asp-action="ForgotPassword" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label fw-semibold small text-muted"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                            <input asp-for="Email" class="form-control border-start-0" placeholder="name@example.com" autocomplete="email" required />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                        <div class="form-text small text-muted">We will send a password reset link to this email address if it is registered.</div>
                    </div>

                    <div class="d-grid mb-4">
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-semibold shadow-sm">
                            <i class="bi bi-send me-2"></i>Send Reset Link
                        </button>
                    </div>

                    <div class="text-center">
                        <p class="text-muted small mb-0">
                            Remembered your password? 
                            <a asp-action="Login" class="text-primary fw-bold text-decoration-none">Back to Sign In</a>
                        </p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
