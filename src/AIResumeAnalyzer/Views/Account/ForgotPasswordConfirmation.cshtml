@model AIResumeAnalyzer.ViewModels.ForgotPasswordConfirmationViewModel
@{
    ViewData["Title"] = "Password Reset Request - AI Resume Analyzer";
}

<div class="row justify-content-center py-5">
    <div class="col-12 col-md-8 col-lg-5 col-xl-4">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="card-header bg-dark text-white text-center py-4 border-0">
                <div class="d-inline-flex p-3 rounded-circle bg-primary bg-opacity-25 mb-3">
                    <span class="p-2 rounded-3 bg-primary text-white d-inline-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                        <i class="bi bi-envelope-check-fill fs-4"></i>
                    </span>
                </div>
                <h3 class="fw-bold mb-1">Reset Request Received</h3>
                <p class="text-white-50 mb-0 small">Account recovery for your profile</p>
            </div>

            <div class="card-body p-4 p-md-4 text-center">
                <p class="text-secondary mb-4">
                    We processed a password reset request for: <br />
                    <strong class="text-dark">@Model.Email</strong>
                </p>

                @if (Model.IsRegisteredUser && !string.IsNullOrEmpty(Model.ResetUrl))
                {
                    <div class="alert alert-primary bg-opacity-10 border-0 rounded-3 p-3 mb-4 text-start">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="bi bi-shield-check text-primary fs-5"></i>
                            <span class="fw-bold text-dark">Direct Access Link</span>
                        </div>
                        <p class="small text-muted mb-3">
                            You can set your new password immediately using the secure one-click link below:
                        </p>
                        <div class="d-grid">
                            <a href="@Model.ResetUrl" class="btn btn-primary rounded-pill fw-semibold py-2">
                                <i class="bi bi-key-fill me-2"></i>Set New Password Now
                            </a>
                        </div>
                    </div>
                }
                else if (!Model.IsRegisteredUser)
                {
                    <div class="alert alert-warning border-0 rounded-3 p-3 mb-4 text-start">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="bi bi-exclamation-triangle-fill text-warning fs-5"></i>
                            <span class="fw-bold text-dark">No Account Found</span>
                        </div>
                        <p class="small text-muted mb-3">
                            No account exists with this email address yet. Would you like to create your free account now?
                        </p>
                        <div class="d-grid">
                            <a asp-action="Register" class="btn btn-primary rounded-pill fw-semibold py-2">
                                <i class="bi bi-person-plus-fill me-2"></i>Create Free Account
                            </a>
                        </div>
                    </div>
                }

                <div class="d-flex justify-content-center gap-3 pt-2">
                    <a asp-action="Login" class="text-primary fw-medium small text-decoration-none">
                        <i class="bi bi-arrow-left me-1"></i>Back to Sign In
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
