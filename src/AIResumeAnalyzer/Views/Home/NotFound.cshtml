@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Page Not Found";
    bool isLoggedIn = (HttpContextAccessor.HttpContext?.Session.GetInt32(SessionKeys.UserId) ?? 0) > 0;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 text-center">
                <div class="display-2 fw-extrabold text-primary mb-2">404</div>
                <h3 class="fw-bold mb-2">Page Not Found</h3>
                <p class="text-muted mb-4">
                    The page you're looking for doesn't exist or may have been moved.
                </p>

                <div class="d-flex flex-wrap justify-content-center gap-2">
                    @if (isLoggedIn)
                    {
                        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary rounded-pill px-4">
                            <i class="bi bi-speedometer2 me-1"></i>Back to Dashboard
                        </a>
                    }
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-house me-1"></i>Return Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
