@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Smart Resume Review & Job Match Intelligence";
    var session = HttpContextAccessor.HttpContext?.Session;
    int? userId = session?.GetInt32(SessionKeys.UserId);
    bool isLoggedIn = userId.HasValue && userId.Value > 0;
}

<!-- 1. STARTUP HERO SECTION -->
<section class="hero-startup py-5">
    <div class="container py-lg-5 position-relative">
        <div class="row align-items-center g-5">
            <!-- Left Hero Copy -->
            <div class="col-12 col-lg-6">
                <div class="hero-eyebrow mb-4">
                    <i class="bi bi-stars"></i>
                    <span>Your Personal Career &amp; Resume Coach</span>
                </div>

                <h1 class="display-4 fw-extrabold text-white lh-sm mb-3">
                    Turn Your Resume Into <span class="text-gradient-brand">Interview Calls.</span>
                </h1>

                <p class="lead text-white-50 mb-4" style="font-size: 1.125rem; line-height: 1.7;">
                    Stop sending applications into the dark. Upload your resume, paste any role you're excited about, and get clear, honest feedback on your strengths, skill gaps, and exact ways to stand out to recruiters.
                </p>

                <div class="d-flex flex-wrap gap-3 mb-4">
                    @if (isLoggedIn)
                    {
                        <a asp-controller="Analysis" asp-action="Create" class="btn btn-hero-primary btn-lg rounded-pill px-4 py-3 fw-semibold">
                            <i class="bi bi-magic me-2"></i>Analyze a Resume Now
                        </a>
                        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-hero-ghost btn-lg rounded-pill px-4 py-3 fw-semibold">
                            <i class="bi bi-speedometer2 me-2"></i>Open My Dashboard
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Register" class="btn btn-hero-primary btn-lg rounded-pill px-4 py-3 fw-semibold">
                            <i class="bi bi-rocket-takeoff me-2"></i>Analyze Your Resume Free
                        </a>
                        <a href="#how-it-works" class="btn btn-hero-ghost btn-lg rounded-pill px-4 py-3 fw-semibold">
                            <i class="bi bi-play-circle me-2"></i>See How It Works
                        </a>
                    }
                </div>

                <!-- User-Centric Trust Indicators -->
                <div class="d-flex flex-wrap align-items-center gap-3 gap-md-4 text-white-50 small pt-2">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill text-success"></i>
                        <span>PDF &amp; DOCX Ready</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill text-success"></i>
                        <span>Instant Career Insights</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-shield-lock-fill text-info"></i>
                        <span>100% Private &amp; Secure</span>
                    </div>
                </div>
            </div>

            <!-- Right Interactive-Feel Product Showcase -->
            <div class="col-12 col-lg-6">
                <div class="hero-preview-wrapper">
                    <div class="hero-preview-card">
                        <!-- Mock App Top Bar -->
                        <div class="hero-preview-header px-4 py-3 d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-2">
                                <span class="rounded-circle bg-danger d-inline-block" style="width: 10px; height: 10px;"></span>
                                <span class="rounded-circle bg-warning d-inline-block" style="width: 10px; height: 10px;"></span>
                                <span class="rounded-circle bg-success d-inline-block" style="width: 10px; height: 10px;"></span>
                                <span class="ms-2 small text-white-50 fw-medium">Resume Match Report</span>
                            </div>
                            <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50 rounded-pill px-3 py-1">
                                <i class="bi bi-check2-circle me-1"></i>Strong Match
                            </span>
                        </div>

                        <!-- Mock App Body -->
                        <div class="p-4">
                            <!-- Top Score Row -->
                            <div class="d-flex align-items-center gap-3 pb-3 mb-3 border-bottom border-secondary border-opacity-25">
                                <div class="score-ring-mini">
                                    <div class="score-ring-mini-inner">
                                        <span class="fw-extrabold text-white fs-4 lh-1">88</span>
                                        <span class="text-white-50" style="font-size: 0.65rem;">/ 100</span>
                                    </div>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="text-white fw-bold fs-6">Software Development Engineer</div>
                                    <div class="text-white-50 small mb-1">Matched 7 of 8 key role competencies</div>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-primary bg-opacity-25 text-info rounded-pill small">Ready to Apply</span>
                                        <span class="text-white-50" style="font-size: 0.75rem;">Updated just now</span>
                                    </div>
                                </div>
                            </div>

                            <!-- 4 Compact Pillar Progress Bars -->
                            <div class="row g-3 mb-3">
                                <div class="col-6">
                                    <div class="d-flex justify-content-between small mb-1">
                                        <span class="text-white-50">Skills Match</span>
                                        <span class="text-white fw-semibold">92%</span>
                                    </div>
                                    <div class="progress bg-secondary bg-opacity-25" style="height: 6px;">
                                        <div class="progress-bar bg-success" style="width: 92%;"></div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="d-flex justify-content-between small mb-1">
                                        <span class="text-white-50">Role Keywords</span>
                                        <span class="text-white fw-semibold">84%</span>
                                    </div>
                                    <div class="progress bg-secondary bg-opacity-25" style="height: 6px;">
                                        <div class="progress-bar bg-info" style="width: 84%;"></div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="d-flex justify-content-between small mb-1">
                                        <span class="text-white-50">Impact &amp; Experience</span>
                                        <span class="text-white fw-semibold">86%</span>
                                    </div>
                                    <div class="progress bg-secondary bg-opacity-25" style="height: 6px;">
                                        <div class="progress-bar bg-primary" style="width: 86%;"></div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="d-flex justify-content-between small mb-1">
                                        <span class="text-white-50">Education &amp; Readiness</span>
                                        <span class="text-white fw-semibold">90%</span>
                                    </div>
                                    <div class="progress bg-secondary bg-opacity-25" style="height: 6px;">
                                        <div class="progress-bar bg-warning" style="width: 90%;"></div>
                                    </div>
                                </div>
                            </div>

                            <!-- Skills Snapshot -->
                            <div class="mb-3">
                                <div class="text-white-50 text-uppercase fw-semibold mb-2" style="font-size: 0.7rem; letter-spacing: 0.06em;">Detected Strengths &amp; Opportunities</div>
                                <div class="d-flex flex-wrap gap-2">
                                    <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25 rounded-pill px-2 py-1 fw-medium">
                                        <i class="bi bi-check2 me-1"></i>Python
                                    </span>
                                    <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25 rounded-pill px-2 py-1 fw-medium">
                                        <i class="bi bi-check2 me-1"></i>REST APIs
                                    </span>
                                    <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25 rounded-pill px-2 py-1 fw-medium">
                                        <i class="bi bi-check2 me-1"></i>SQL Databases
                                    </span>
                                    <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25 rounded-pill px-2 py-1 fw-medium">
                                        <i class="bi bi-check2 me-1"></i>Git &amp; CI/CD
                                    </span>
                                    <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-25 rounded-pill px-2 py-1 fw-medium">
                                        <i class="bi bi-plus-circle me-1"></i>Docker
                                    </span>
                                </div>
                            </div>

                            <!-- Floating Career Coach Insight -->
                            <div class="floating-coach-tip p-3">
                                <div class="d-flex align-items-start gap-2">
                                    <span class="text-success fs-5 lh-1 mt-1"><i class="bi bi-lightbulb-fill"></i></span>
                                    <div class="small">
                                        <div class="fw-bold text-white mb-1">Career Coach Suggestion</div>
                                        <div class="text-white-50" style="font-size: 0.82rem;">
                                            Quantify your backend project impact — e.g., <span class="text-white">"Improved API latency by 35% for 2,000+ daily requests"</span> — to catch recruiter attention immediately.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 2. VALUE PROPOSITION STRIP -->
<section class="py-5 bg-white border-bottom" id="features">
    <div class="container py-lg-4">
        <div class="text-center mx-auto mb-5" style="max-width: 680px;">
            <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2 fw-semibold mb-2">
                WHY JOB SEEKERS CHOOSE US
            </span>
            <h2 class="fw-extrabold mb-3">More Than a Score — A Clear Roadmap to Get Hired</h2>
            <p class="text-muted mb-0">
                Most resume checkers just throw a harsh number at you. We show you what recruiters actually look for, celebrate your strengths, and give you practical edits that make a real difference.
            </p>
        </div>

        <div class="row g-4">
            <div class="col-12 col-md-6 col-lg-3">
                <div class="card h-100 rounded-4 p-4 card-hover border">
                    <div class="icon-box-soft bg-primary bg-opacity-10 text-primary mb-3">
                        <i class="bi bi-bullseye"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Smart Skill Gap Radar</h5>
                    <p class="text-muted small mb-0">
                        Instantly spot matched skills, transferable strengths you already possess, and high-impact gaps to address before hitting submit.
                    </p>
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-3">
                <div class="card h-100 rounded-4 p-4 card-hover border">
                    <div class="icon-box-soft bg-success bg-opacity-10 text-success mb-3">
                        <i class="bi bi-chat-square-heart"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Honest, Practical Coaching</h5>
                    <p class="text-muted small mb-0">
                        Get real writing advice — from adding measurable results and stronger action verbs to highlighting missing role phrasing naturally.
                    </p>
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-3">
                <div class="card h-100 rounded-4 p-4 card-hover border">
                    <div class="icon-box-soft bg-info bg-opacity-10 text-info mb-3">
                        <i class="bi bi-sliders"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Fair, Balanced Evaluation</h5>
                    <p class="text-muted small mb-0">
                        Built to recognize related tools and real project value — never penalizing great candidates over minor wording differences.
                    </p>
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-3">
                <div class="card h-100 rounded-4 p-4 card-hover border">
                    <div class="icon-box-soft bg-warning bg-opacity-10 text-warning mb-3">
                        <i class="bi bi-file-earmark-pdf"></i>
                    </div>
                    <h5 class="fw-bold mb-2">History &amp; PDF Reports</h5>
                    <p class="text-muted small mb-0">
                        Compare multiple resume versions across different job postings and export clean, printable review reports anytime.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 3. 3-STEP WORKFLOW -->
<section class="py-5" id="how-it-works">
    <div class="container py-lg-4">
        <div class="text-center mx-auto mb-5" style="max-width: 640px;">
            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 fw-semibold mb-2">
                HOW IT WORKS
            </span>
            <h2 class="fw-extrabold mb-3">From Resume Upload to Interview-Ready in 60 Seconds</h2>
            <p class="text-muted mb-0">
                No complicated setup. Three simple steps to tailor your resume for every opportunity you care about.
            </p>
        </div>

        <div class="row g-4">
            <div class="col-12 col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 p-lg-5 card-hover position-relative">
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <span class="step-number-pill bg-primary text-white">1</span>
                        <i class="bi bi-cloud-arrow-up text-primary fs-2 opacity-75"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Upload Your Resume</h5>
                    <p class="text-muted small mb-0">
                        Drop in your PDF or DOCX resume. Your document is parsed cleanly and kept strictly private inside your personal workspace.
                    </p>
                </div>
            </div>

            <div class="col-12 col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 p-lg-5 card-hover position-relative">
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <span class="step-number-pill bg-info text-white">2</span>
                        <i class="bi bi-briefcase text-info fs-2 opacity-75"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Paste Your Target Job</h5>
                    <p class="text-muted small mb-0">
                        Add the job title and description from LinkedIn, Indeed, or any career portal — or pick a sample role to test right away.
                    </p>
                </div>
            </div>

            <div class="col-12 col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 p-lg-5 card-hover position-relative">
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <span class="step-number-pill bg-success text-white">3</span>
                        <i class="bi bi-graph-up-arrow text-success fs-2 opacity-75"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Refine &amp; Apply Confidently</h5>
                    <p class="text-muted small mb-0">
                        Review your compatibility breakdown, follow the personalized improvement checklist, and submit your strongest application yet.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 4. SCORING TRANSPARENCY & REVIEW PILLARS -->
<section class="py-5 bg-white border-top border-bottom" id="methodology">
    <div class="container py-lg-4">
        <div class="row align-items-center g-5">
            <div class="col-12 col-lg-5">
                <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2 fw-semibold mb-2">
                    TRANSPARENT SCORING
                </span>
                <h2 class="fw-extrabold mb-3">Know Exactly <em>Why</em> You Scored What You Did</h2>
                <p class="text-muted mb-4">
                    No mysterious black-box grades. Every review breaks your readiness down across four clear career pillars — giving you credit for transferable skills, measurable achievements, and strong structure.
                </p>

                <div class="d-flex flex-column gap-3 mb-4">
                    <div class="d-flex align-items-start gap-3">
                        <span class="text-success fs-5 mt-1"><i class="bi bi-check-circle-fill"></i></span>
                        <div>
                            <div class="fw-bold text-dark">Recognizes Related &amp; Transferable Skills</div>
                            <div class="text-muted small">Know MySQL when the role asks for SQL Server? We give fair partial credit and show you how to bridge it.</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-start gap-3">
                        <span class="text-success fs-5 mt-1"><i class="bi bi-check-circle-fill"></i></span>
                        <div>
                            <div class="fw-bold text-dark">Zero Fluff, Real Keyword Insights</div>
                            <div class="text-muted small">Filters out generic HR filler words so your score reflects actual domain and role alignment.</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-start gap-3">
                        <span class="text-success fs-5 mt-1"><i class="bi bi-check-circle-fill"></i></span>
                        <div>
                            <div class="fw-bold text-dark">Ethical Career Guidance</div>
                            <div class="text-muted small">We help you articulate your real skills and impact better — never suggesting fabricated experience.</div>
                        </div>
                    </div>
                </div>

                @if (!isLoggedIn)
                {
                    <a asp-controller="Account" asp-action="Register" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold shadow-sm">
                        Try Your First Review Free <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                }
            </div>

            <div class="col-12 col-lg-7">
                <div class="row g-3">
                    <div class="col-12 col-sm-6">
                        <div class="card h-100 rounded-4 p-4 border card-hover">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <span class="badge bg-primary rounded-pill px-3 py-1">40% Weight</span>
                                <i class="bi bi-code-square text-primary fs-3"></i>
                            </div>
                            <h5 class="fw-bold mb-2">Core &amp; Related Skills</h5>
                            <p class="text-muted small mb-0">
                                Matches technical tools, frameworks, languages, and professional skills against the role — with smart credit for closely related experience.
                            </p>
                        </div>
                    </div>

                    <div class="col-12 col-sm-6">
                        <div class="card h-100 rounded-4 p-4 border card-hover">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <span class="badge bg-info text-dark rounded-pill px-3 py-1">25% Weight</span>
                                <i class="bi bi-search-heart text-info fs-3"></i>
                            </div>
                            <h5 class="fw-bold mb-2">Role Language &amp; Keywords</h5>
                            <p class="text-muted small mb-0">
                                Pinpoints the exact domain phrases hiring teams scan for and shows which missing keywords will naturally strengthen your bullet points.
                            </p>
                        </div>
                    </div>

                    <div class="col-12 col-sm-6">
                        <div class="card h-100 rounded-4 p-4 border card-hover">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <span class="badge bg-success rounded-pill px-3 py-1">20% Weight</span>
                                <i class="bi bi-award text-success fs-3"></i>
                            </div>
                            <h5 class="fw-bold mb-2">Experience &amp; Measurable Impact</h5>
                            <p class="text-muted small mb-0">
                                Evaluates action verbs, real project ownership, internships, and quantified metrics that turn passive duties into standout achievements.
                            </p>
                        </div>
                    </div>

                    <div class="col-12 col-sm-6">
                        <div class="card h-100 rounded-4 p-4 border card-hover">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <span class="badge bg-warning text-dark rounded-pill px-3 py-1">15% Weight</span>
                                <i class="bi bi-mortarboard text-warning fs-3"></i>
                            </div>
                            <h5 class="fw-bold mb-2">Education &amp; Readiness</h5>
                            <p class="text-muted small mb-0">
                                Recognizes degrees, relevant coursework, certifications, and portfolio links like GitHub and LinkedIn to give a complete readiness picture.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 5. BUILT FOR EVERY CAREER STAGE -->
<section class="py-5">
    <div class="container py-lg-4">
        <div class="text-center mx-auto mb-5" style="max-width: 660px;">
            <span class="badge bg-info bg-opacity-10 text-info rounded-pill px-3 py-2 fw-semibold mb-2">
                FOR EVERY AMBITIOUS CANDIDATE
            </span>
            <h2 class="fw-extrabold mb-3">Designed to Grow With Your Career</h2>
            <p class="text-muted mb-0">
                Whether you're applying for your first internship or stepping into a senior role, get tailored guidance that meets you where you are.
            </p>
        </div>

        <div class="row g-4">
            <div class="col-12 col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 card-hover">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="icon-box-soft bg-primary bg-opacity-10 text-primary">
                            <i class="bi bi-backpack2"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-0">Students &amp; Freshers</h5>
                            <small class="text-muted">Internships &amp; First Roles</small>
                        </div>
                    </div>
                    <p class="text-muted small mb-0">
                        Transform academic projects, hackathons, and coursework into crisp, impact-focused bullet points that prove you're ready to contribute from day one.
                    </p>
                </div>
            </div>

            <div class="col-12 col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 card-hover">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="icon-box-soft bg-success bg-opacity-10 text-success">
                            <i class="bi bi-signpost-split"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-0">Career Switchers</h5>
                            <small class="text-muted">Pivoting to New Domains</small>
                        </div>
                    </div>
                    <p class="text-muted small mb-0">
                        Uncover which transferable skills already carry weight in your new target field and identify the exact 2–3 skills worth showcasing next.
                    </p>
                </div>
            </div>

            <div class="col-12 col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 card-hover">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="icon-box-soft bg-warning bg-opacity-10 text-warning">
                            <i class="bi bi-briefcase-fill"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-0">Working Professionals</h5>
                            <small class="text-muted">Targeting Senior Opportunities</small>
                        </div>
                    </div>
                    <p class="text-muted small mb-0">
                        Tailor your resume to specific leadership and engineering roles in minutes, keep past reviews organized, and export clean PDFs for mentors.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 6. FINAL CALL-TO-ACTION BANNER -->
<section class="py-5">
    <div class="container">
        <div class="cta-banner-dark p-4 p-md-5 text-center text-white shadow-lg">
            <div class="mx-auto py-3" style="max-width: 680px;">
                <span class="badge bg-white bg-opacity-10 text-info border border-info border-opacity-25 rounded-pill px-3 py-2 mb-3">
                    <i class="bi bi-sparkles me-1"></i>Start Building Career Momentum Today
                </span>
                <h2 class="display-6 fw-extrabold text-white mb-3">
                    Your Next Great Opportunity Starts With a Stronger Resume.
                </h2>
                <p class="text-white-50 mb-4">
                    Create your free account in seconds, upload your resume, and see exactly how to elevate your next application.
                </p>
                <div class="d-flex flex-wrap justify-content-center gap-3">
                    @if (isLoggedIn)
                    {
                        <a asp-controller="Analysis" asp-action="Create" class="btn btn-hero-primary btn-lg rounded-pill px-5 py-3 fw-semibold">
                            <i class="bi bi-cpu me-2"></i>Run a New Resume Review
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Register" class="btn btn-hero-primary btn-lg rounded-pill px-5 py-3 fw-semibold">
                            <i class="bi bi-person-plus me-2"></i>Get Started — It's Free
                        </a>
                        <a asp-controller="Account" asp-action="Login" class="btn btn-hero-ghost btn-lg rounded-pill px-4 py-3 fw-semibold">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
